#include <iostream>
#include <vector>
#include <string>
using namespace std;

int main() {
    vector<string> tas = {"Pedang Kayu", "Perisai Besi"};

    cout << tas[0] << endl;

    tas.insert(tas.begin(), "Potion Darah");
    tas.insert(tas.begin() + 2, "Busur Panah");
    
    cout << "setelah ditambah: ";
    for (const string& item : tas) {
        cout << item << " ";
    }
    cout << endl;
    
    tas.pop_back();
    
    cout << "setelah dihapus: ";
    for (const string& item : tas) {
        cout << item << " ";
    }
    cout << endl;

    return 0;
}
